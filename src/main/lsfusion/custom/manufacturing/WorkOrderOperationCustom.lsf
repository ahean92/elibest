MODULE WorkOrderOperationCustom;

REQUIRE WorkOrderOperation, WorkOrderDone, BomCustom, BomNested;

NAMESPACE Manufacturing;

isDirectParent (Bom b, Bom p) = GROUP SUM 1 IF b == nestedBom(ComponentLine cl) AND p == bom(cl);

level (Bom child, Bom parent) = RECURSION 1l IF child IS Bom AND parent == child
    STEP 2l IF isDirectParent($parent, parent);

parent(Bom b, ManufacturingOrder mo) = GROUP MAX Bom bb IF bom(ComponentLine cl) == bb AND nestedBom(cl) == b AND level(bb, bom(mo)) AND b != bom(mo);
parentLoc = DATA LOCAL ManufacturingOrder();
parentLoc (Bom b) = parent(b, parentLoc());

CLASS WorkStep 'Этап производства';
name 'Этап' = DATA ISTRING[100](WorkStep);
parent = DATA WorkStep(WorkStep);
manufacturingOrder = DATA ManufacturingOrder(WorkStep);
createdStep = DATA LOCAL WorkStep (Bom);
workStep = DATA WorkStep(WorkOrder);
sourceLine = DATA WorkStep(ConsumedLine);

item '{Item}' = DATA Item (WorkStep);
nameItem '{Item}' (WorkStep l) = name(item(l)) IN id;
idBarCodeItem 'Barcode' (WorkStep l) = idBarCode(item(l));
idItem '{ID}' (WorkStep l) = id(item(l));

uom 'UoM' = DATA Uom (WorkStep);
nameUom 'UoM' (WorkStep l) = name(uom(l));
WHEN LOCAL CHANGED(item(WorkStep l)) DO uom(l) <- uom(item(l));

toProduce '{Manufacture}' = DATA NUMERIC[16,3] (WorkStep);
locationResult = DATA Location (WorkStep);

// Снимок со спецификации: правка спецификации не меняет запущенные заказы.
useLot 'Формировать партии' = DATA BOOLEAN (WorkStep);

componentLine = DATA ComponentLine(ConsumedLine);

done 'Выполнен' (WorkStep s) = NOT GROUP SUM 1 IF workStep(WorkOrder o) = s AND NOT done(o);
canceled 'Canceled' = DATA BOOLEAN (WorkStep);
active '{Active}' (WorkStep o) = done(o) AND NOT canceled(o);

fill(ConsumedLine cl, ComponentLine l) +{
    componentLine(cl) <- l;
}

isFinishWorkStep(WorkStep s) = GROUP SUM 1 IF item(s) = item(manufacturingOrder(s));
executionDateTime 'Execution date' = DATA DATETIME (WorkStep);
quantity 'Кол-во' = DATA NUMERIC[16,3] (WorkStep);

// Фактический выпуск этапа. Пусто — значит вышло по плану.
produced 'Произведено' = DATA NUMERIC[16,3] (WorkStep);
producedQuantity 'Произведено' (WorkStep s) = OVERRIDE produced(s), quantity(s);

CONSTRAINT produced(WorkStep s) > quantity(s)
    MESSAGE 'Произведено больше, чем запланировано на этапе производства';
componentLine(Bom b, ManufacturingOrder o) = GROUP MAX ComponentLine cl IF nestedBom(cl) = b AND level(bom(cl), bom(o));
 
WHEN SET(done(WorkStep o)) AND NOT CHANGED(executionDateTime(o)) DO executionDateTime(o) <- currentDateTime();

fillByQuantity (ManufacturingOrder o, NUMERIC[16,3] q) + {
    DELETE WorkStep ws WHERE manufacturingOrder(ws) = o;
    FOR level(Bom b, bom(o)) ORDER level(b, bom(o)) DO NEW ws = WorkStep {
        name(ws) <- name(b);
        manufacturingOrder(ws) <- o;
        item(ws) <- item(b);
        uom(ws) <- uom(b);
        toProduce(ws) <- q;
        locationResult(ws) <- locationResult(b); 
        createdStep(b) <- ws;
        useLot(ws) <- useLot(b);
        workStep(WorkOrder wo) <- ws WHERE bom(operation(wo)) = b AND manufacturingOrder(wo) = o;
        sourceLine(ConsumedLine l) <- ws WHERE bom(componentLine(l)) = b AND manufacturingOrder(l) = o;
        IF parent(b, o) THEN {
            parent(ws) <- createdStep(parent(b, o));
        }
        quantity(ws) <- OVERRIDE NUMERIC[16,3] (quantity(parent(ws)) * quantity(componentLine(b, o))), q;
    }
}

EXTEND FORM manufacturingOrder
    TREE workOrderOperation ws 'Производственные задания' = WorkStep PARENT parent(ws)
    PROPERTIES (ws) READONLY name, quantity, done
    PROPERTIES (ws) produced
    FILTERS manufacturingOrder(ws) = o

    OBJECTS opt 'Операции' = WorkOrder
    PROPERTIES(opt) READONLY name, imagedNameStatus BACKGROUND colorStatus(opt), nameWorkCenter, startDate, startTime, duration, descriptionBom
    FILTERS workStep(opt) = ws
;


DESIGN manufacturingOrder {
    details {
        REMOVE BOX(wo);
        NEW workOperationsPane {
            fill = 1;
            horizontal = TRUE;
            caption = badged('Work orders', countWorkOrder(o));
            MOVE BOX(TREE workOrderOperation) {
                fill = 1;
            }
            MOVE BOX(opt) {
                fill = 2;
            }
        }
    }
}



